# AWS configuration for the app (non-secret identifiers — safe to ship in-app).
# Copy to `.env` and fill in. After changing, restart Metro with: yarn start --reset-cache
AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_IDENTITY_POOL_ID=ap-south-1:00000000-0000-0000-0000-000000000000
IOT_ENDPOINT=xxxxxxxxxxxxxx-ats.iot.ap-south-1.amazonaws.com
IOT_POLICY_NAME=dtx_smart_device_policy
